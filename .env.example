# ---------------------------------------------------------------------------
# dVPN-backend environment variables
# Copy this file to `.env` and replace the values below with your own.
# Every variable the application reads is listed here.
#
# NOTE: the values below are ILLUSTRATIVE EXAMPLES that show the expected
# format only. They are NOT real credentials. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development          # development | production
PORT=7000                     # HTTP port the server listens on
APP_VERSION=1.0.0

# --- Database (PostgreSQL, separate read/write endpoints) ---
# Write (primary)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=9876            # matches docker-compose.yml's local Postgres port
DB_WRITE_NAME=dvpn_db
DB_WRITE_USER=postgres
DB_WRITE_PASS=change_me
# Read (replica; can point to the same host for local dev)
DB_READ_HOST=localhost
DB_READ_NAME=dvpn_db
DB_READ_USER=postgres
DB_READ_PASS=change_me
# Common
DB_SCHEMA=public
DB_SSL=false                  # true to require SSL
DB_CA_CERT=                   # PEM CA certificate (or path) when DB_SSL=true

# --- Redis ---
# With AUTH: redis://:your_redis_password@localhost:6379/0
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (use long, unique random strings) ---
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# --- Chain / external APIs ---
CHAIN_URL=https://rpc.example.com                 # RPC / chain endpoint
CURRENT_TOKEN_API=https://api.example.com/token/price   # token price / info API
